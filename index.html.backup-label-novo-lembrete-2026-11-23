    function importJSON(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          const importedList = Array.isArray(parsed) ? parsed : parsed.bookings;
          if (!Array.isArray(importedList)) throw new Error('Formato inválido');
          bookings = importedList;
          const importedSettings = !Array.isArray(parsed) && parsed.settings && typeof parsed.settings === 'object'
            ? parsed.settings
            : {};
          settings = {
            soundEnabled: true,
            leadTimeMinutes: 15,
            notifiedEvents: {},
            teachers: [],
            classes: [],
            equipment: [],
            schoolCatalogsResetV1: true,
            ...importedSettings,
            schoolCatalogsResetV1: true
          };
      ensureProfessorSchedule();
      normalizeSchoolCatalogs();
          saveState();
          populateTeacherOptions();
          populateClassOptions();
          renderQuickEquipmentChips();
          renderAll();
          closeSettingsModal();
          showToast(`${bookings.length} agendamento(s) importado(s) com sucesso!`, 'success');
        } catch (err) {
          showToast('Arquivo JSON inválido. Verifique o arquivo selecionado.', 'error');
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

