                  <p class="text-xs text-slate-500 mt-1 flex items-center gap-1.5">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-slate-400 shrink-0"></i>
                    <span>${escapeHTML(b.notes)}</span>
                  </p>
                ` : ''}
