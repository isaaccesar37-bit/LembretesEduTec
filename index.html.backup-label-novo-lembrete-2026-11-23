    function saveBooking(event) {
      event.preventDefault();

      if (modalSelectedEquipments.length === 0) {
        showToast('Selecione pelo menos um equipamento antes de salvar.', 'warning');
        return;
      }

      const id = document.getElementById('field-id').value;
      const teacher = document.getElementById('field-teacher').value.trim();
      const className = document.getElementById('field-class').value.trim();
      const date = document.getElementById('field-date').value;
      const deliveryTime = document.getElementById('field-delivery-time').value;
      const pickupTime = document.getElementById('field-pickup-time').value;
      const notes = document.getElementById('field-notes').value.trim();

      if (pickupTime <= deliveryTime) {
        showToast('O horário de recolhimento deve ser posterior ao de entrega.', 'warning');
        return;
      }

      if (id) {
        const idx = bookings.findIndex(b => b.id === id);
        if (idx !== -1) {
          bookings[idx] = {
            ...bookings[idx],
            teacher,
            className,
            date,
            deliveryTime,
            pickupTime,
            notes,
            equipments: modalSelectedEquipments
          };
          // Limpa flags de notificação caso o horário tenha sido alterado
          delete settings.notifiedEvents[`${id}_pending_upcoming`];
          delete settings.notifiedEvents[`${id}_pending_overdue`];
          delete settings.notifiedEvents[`${id}_in_use_upcoming`];
          delete settings.notifiedEvents[`${id}_in_use_overdue`];
        }
        showToast('Agendamento atualizado com sucesso!', 'success');
      } else {
        const newBooking = {
          id: 'bk_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
          teacher,
          className,
          date,
          deliveryTime,
          pickupTime,
          notes,
          equipments: modalSelectedEquipments,
          status: 'pending' // pending | in_use | completed
        };
        bookings.push(newBooking);
        showToast('Novo lembrete cadastrado!', 'success');
      }

      saveState();
      closeBookingModal();
      renderAll();
    }

