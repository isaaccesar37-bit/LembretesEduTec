    }

    function getEquipmentIcon(name) {
      const lower = name.toLowerCase();
      if (lower.includes('notebook') || lower.includes('laptop') || lower.includes('chromebook')) return 'laptop';
      if (lower.includes('tablet') || lower.includes('ipad')) return 'tablet';
      if (lower.includes('vr') || lower.includes('óculos') || lower.includes('oculos')) return 'glasses';
      if (lower.includes('braço') || lower.includes('robô') || lower.includes('robo')) return 'bot';
      if (lower.includes('fone') || lower.includes('headset')) return 'headphones';
      if (lower.includes('projetor') || lower.includes('datashow')) return 'projector';
      if (lower.includes('som') || lower.includes('caixa')) return 'speaker';
      return 'cpu';
    }

    // =========================================================================
    // AÇÕES DE STATUS, FILTROS E BUSCA
    // =========================================================================
    function advanceStatus(id, newStatus) {
      const applyStatus = () => {
        const idx = bookings.findIndex(b => b.id === id);
        if (idx === -1) return;
        bookings[idx].status = newStatus;
        saveState();
        renderAll();

        if (newStatus === 'in_use') {
          showToast(`Equipamento entregue para ${bookings[idx].teacher}. Lembrete de recolhimento ativo!`, 'success');
        } else if (newStatus === 'completed') {
          showToast(`Devolução de ${bookings[idx].teacher} concluída!`, 'success');
        }
      };

      if (newStatus === 'in_use') {
        const booking = bookings.find(b => b.id === id);
        if (!booking) return;
        if (!isWithinConfirmationWindow(booking.date, booking.deliveryTime)) {
          openConfirmModal(
            'Confirmar entrega dos equipamentos?',
            `Confirma a entrega dos equipamentos para ${booking.teacher} (${booking.className})?`,
            applyStatus
          );
          return;
        }
      }
      applyStatus();
    }

    function toggleBookingCalendar() {
      const panel = document.getElementById('booking-calendar-panel');
      const button = document.getElementById('booking-calendar-toggle');
      const isOpening = panel.classList.contains('hidden');
      panel.classList.toggle('hidden', !isOpening);
      button.setAttribute('aria-expanded', String(isOpening));
      button.className = 'flex h-8 w-9 shrink-0 items-center justify-center rounded-lg transition ' + (isOpening ? 'bg-white text-emerald-700 shadow-sm' : 'text-slate-600 hover:bg-white hover:text-emerald-700');
      document.querySelectorAll('.date-filter-btn').forEach(btn => {
        const isSelected = !isOpening && btn.dataset.dateFilter === currentDateFilter;
        btn.className = 'date-filter-btn flex-1 lg:flex-none px-3.5 py-1.5 rounded-lg text-xs font-semibold transition ' + (isSelected ? 'bg-white text-brand-900 shadow-sm' : 'text-slate-600 hover:text-slate-900');
      });
      if (isOpening) renderBookingCalendar();
    }

    function changeBookingCalendarMonth(amount) {
      bookingCalendarDate = new Date(bookingCalendarDate.getFullYear(), bookingCalendarDate.getMonth() + amount, 1);
      renderBookingCalendar();
    }

    function openBookingCalendarDay(date) {
      selectedBookingCalendarDate = date;
      renderBookingCalendarDayDetails();
      document.getElementById('booking-day-dialog').showModal();
    }

    function closeBookingCalendarDay() {
      document.getElementById('booking-day-dialog').close();
    }

    function renderBookingCalendarDayDetails() {
      const date = selectedBookingCalendarDate;
      const title = document.getElementById('booking-day-title');
      const list = document.getElementById('booking-day-details');
      if (!date || !title || !list) return;
      const dayBookings = bookings.filter(item => item.date === date).sort((a, b) => String(a.deliveryTime || '').localeCompare(String(b.deliveryTime || '')));
      title.textContent = new Date(`${date}T12:00:00`).toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      if (!dayBookings.length) {
        list.innerHTML = '<div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-sm text-slate-500">Nenhum agendamento nesta data.</div>';
        return;
      }
      list.innerHTML = dayBookings.map(item => {
        const statusInfo = item.status === 'completed'
          ? { label: 'Concluído', style: 'bg-slate-100 text-slate-700' }
          : item.status === 'in_use'
            ? { label: 'Em uso', style: 'bg-amber-100 text-amber-800' }
            : { label: 'Pendente', style: 'bg-emerald-100 text-emerald-800' };
        const equipmentList = Array.isArray(item.equipments) && item.equipments.length
          ? item.equipments.map(equipment => `<span class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">${escapeHTML(equipment.qty)}× ${escapeHTML(equipment.name)}</span>`).join('')
          : '<span class="text-xs text-slate-500">Equipamentos não informados</span>';
        return `<article class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm"><div class="flex flex-wrap items-start justify-between gap-2"><div><h3 class="font-bold text-slate-900">${escapeHTML(item.teacher || 'Professor(a) não informado(a)')}</h3><p class="mt-1 text-sm text-slate-600">Turma: <strong>${escapeHTML(item.className || 'Não informada')}</strong></p></div><span class="rounded-full px-2.5 py-1 text-xs font-bold ${statusInfo.style}">${statusInfo.label}</span></div><div class="mt-3 grid grid-cols-1 gap-2 rounded-xl bg-slate-50 p-3 text-sm sm:grid-cols-2"><p><span class="font-semibold text-slate-600">Entrega:</span> ${escapeHTML(item.deliveryTime || '—')}</p><p><span class="font-semibold text-slate-600">Devolução:</span> ${escapeHTML(item.pickupTime || '—')}</p></div><div class="mt-3 flex flex-wrap gap-1.5">${equipmentList}</div>${item.notes ? `<p class="mt-3 border-t border-slate-100 pt-3 text-sm text-slate-600">${escapeHTML(item.notes)}</p>` : ''}</article>`;
      }).join('');
    }

    function renderBookingCalendar() {
      const title = document.getElementById('booking-calendar-title');
      const grid = document.getElementById('booking-calendar-grid');
      if (!title || !grid) return;
      const year = bookingCalendarDate.getFullYear();
      const month = bookingCalendarDate.getMonth();
      const monthKey = `${year}-${String(month + 1).padStart(2, '0')}`;
      title.textContent = bookingCalendarDate.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
      document.getElementById('booking-calendar-count').textContent = `${bookings.filter(item => String(item.date || '').startsWith(monthKey)).length} agendamento(s) no mês`;
      const offset = (new Date(year, month, 1).getDay() + 6) % 7;
      const start = new Date(year, month, 1 - offset);
      const today = getTodayISO();
      const cells = [];
      for (let index = 0; index < 42; index++) {
        const date = new Date(start.getFullYear(), start.getMonth(), start.getDate() + index);
        const isoDate = localDateToISO(date);
        const inMonth = date.getMonth() === month;
        const dayBookings = bookings.filter(item => item.date === isoDate).sort((a, b) => String(a.deliveryTime || '').localeCompare(String(b.deliveryTime || '')));
        const events = dayBookings.length
          ? dayBookings.map(item => {
              const statusClass = item.status === 'completed' ? 'bg-slate-100 text-slate-600' : item.status === 'in_use' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-50 text-emerald-800';
              return `<div class="truncate rounded px-1 py-0.5 text-left text-[8px] leading-tight sm:text-[10px] ${statusClass}" title="${escapeHTML(item.deliveryTime || '')} · ${escapeHTML(item.className || '')} · ${escapeHTML(item.teacher || '')}"><b>${escapeHTML(item.deliveryTime || '')}</b> ${escapeHTML(item.className || '')}<span class="hidden sm:inline"> · ${escapeHTML(item.teacher || '')}</span></div>`;
            }).join('')
          : '';
        cells.push(`<div role="button" tabindex="0" onclick="openBookingCalendarDay('${isoDate}')" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openBookingCalendarDay('${isoDate}')}" aria-label="Abrir detalhes dos agendamentos de ${formatDateBR(isoDate)}" class="min-h-[76px] cursor-pointer overflow-hidden rounded-lg border ${inMonth ? 'border-slate-200 bg-white' : 'border-slate-100 bg-slate-50/60'} p-1 transition hover:border-emerald-300 hover:bg-emerald-50/40 focus:outline-none focus:ring-2 focus:ring-emerald-500 sm:min-h-[108px] sm:rounded-xl sm:p-1.5"><span class="mb-1 flex h-6 w-6 items-center justify-center rounded-full text-[10px] font-bold ${isoDate === today ? 'bg-emerald-600 text-white' : inMonth ? 'text-slate-700' : 'text-slate-300'}">${date.getDate()}</span><div class="max-h-[76px] space-y-0.5 overflow-y-auto sm:max-h-[82px]">${events}</div></div>`);
      }
      grid.innerHTML = cells.join('');
      lucide.createIcons();
    }

    function setDateFilter(filter, date = '') {
      currentDateFilter = filter;
      selectedBookingCalendarDate = filter === 'specific' ? date : '';
      if (filter !== 'specific') {
        const calendarPanel = document.getElementById('booking-calendar-panel');
        const calendarButton = document.getElementById('booking-calendar-toggle');
        calendarPanel.classList.add('hidden');
        calendarButton.setAttribute('aria-expanded', 'false');
        calendarButton.className = 'flex h-8 w-9 shrink-0 items-center justify-center rounded-lg text-slate-600 transition hover:bg-white hover:text-emerald-700';
      }
      document.querySelectorAll('.date-filter-btn').forEach(btn => {
        if (btn.dataset.dateFilter === filter) {
          btn.className = 'date-filter-btn flex-1 lg:flex-none px-3.5 py-1.5 rounded-lg text-xs font-semibold transition bg-white text-brand-900 shadow-sm';
        } else {
          btn.className = 'date-filter-btn flex-1 lg:flex-none px-3.5 py-1.5 rounded-lg text-xs font-semibold transition text-slate-600 hover:text-slate-900';
        }
      });
      renderAll();
    }

    function setStatusFilter(filter) {
      currentStatusFilter = filter;
      document.querySelectorAll('.status-filter-btn').forEach(btn => {
        if (btn.dataset.statusFilter === filter) {
          btn.className = 'status-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold border transition bg-brand-900 text-white border-brand-900';
        } else {
          btn.className = 'status-filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold border transition bg-white text-slate-600 border-slate-200 hover:bg-slate-50';
        }
      });
      renderAll();
    }

    function handleSearch(val) {
      currentSearchQuery = val;
      const clearBtn = document.getElementById('clear-search-btn');
      if (val.trim().length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }
      renderAll();
    }

    function clearSearch() {
      document.getElementById('search-input').value = '';
      handleSearch('');
    }

    // =========================================================================
    // MODAL DE CADASTRO / EDIÇÃO DE AGENDAMENTOS
    // =========================================================================
    function openBookingModal(bookingToEdit = null) {
      populateTeacherOptions();
      renderQuickEquipmentChips();

      const modal = document.getElementById('booking-modal');
      const titleEl = document.getElementById('modal-title');

      if (bookingToEdit) {
        pickupTimeManuallyEdited = true;
        titleEl.textContent = 'Editar Agendamento';
        document.getElementById('field-id').value = bookingToEdit.id;
        document.getElementById('field-teacher').value = bookingToEdit.teacher;
        document.getElementById('field-class').value = bookingToEdit.className;
        document.getElementById('field-date').value = bookingToEdit.date;
        document.getElementById('field-delivery-time').value = bookingToEdit.deliveryTime;
        document.getElementById('field-pickup-time').value = bookingToEdit.pickupTime;
        document.getElementById('field-notes').value = bookingToEdit.notes || '';
        modalSelectedEquipments = JSON.parse(JSON.stringify(bookingToEdit.equipments));
      } else {
        pickupTimeManuallyEdited = false;
        titleEl.textContent = 'Novo Lembrete de Equipamento';
        document.getElementById('booking-form').reset();
        document.getElementById('field-id').value = '';
        document.getElementById('field-date').value = getTodayISO();

        // Sugere horário próximo arredondado
        const now = new Date();
        now.setMinutes(now.getMinutes() + 10);
        const hh = String(now.getHours()).padStart(2, '0');
        const mm = String(now.getMinutes()).padStart(2, '0');
        document.getElementById('field-delivery-time').value = `${hh}:${mm}`;

        suggestPickupTimeFromDelivery();

        modalSelectedEquipments = [];
      }

      renderSelectedEquipmentsList();
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function closeBookingModal() {
      const modal = document.getElementById('booking-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function suggestPickupTimeFromDelivery() {
      if (pickupTimeManuallyEdited) return;
      const deliveryTime = document.getElementById('field-delivery-time').value;
      if (!deliveryTime) return;
      const [hours, minutes] = deliveryTime.split(':').map(Number);
      const pickup = new Date();
      pickup.setHours(hours, minutes + 50, 0, 0);
      document.getElementById('field-pickup-time').value = `${String(pickup.getHours()).padStart(2, '0')}:${String(pickup.getMinutes()).padStart(2, '0')}`;
    }

    function markPickupTimeManual() {
      pickupTimeManuallyEdited = true;
    }

    function editBooking(id) {
      const booking = bookings.find(b => b.id === id);
      if (booking) openBookingModal(booking);
    }

    function populateTeacherOptions() {
      const select = document.getElementById('field-teacher');
      const uniqueTeachers = [...new Set(bookings.map(b => b.teacher))];
      const merged = [...new Set([...(settings.teachers || []), ...uniqueTeachers])];
      select.innerHTML = '<option value="">Selecione um professor</option>' + merged.map(name => `<option value="${escapeHTML(name)}">${escapeHTML(name)}</option>`).join('');
    }

    function populateClassOptions() {
      const select = document.getElementById('field-class');
      const previousClasses = bookings.map(booking => booking.className).filter(Boolean);
      const classes = [...new Set([...(settings.classes || []), ...previousClasses])];
      select.innerHTML = '<option value="">Selecione uma turma</option>' + classes.map(name => `<option value="${escapeHTML(name)}">${escapeHTML(name)}</option>`).join('');
    }

    function renderQuickEquipmentChips() {
      const container = document.getElementById('quick-equipment-chips');
      const equipment = settings.equipment || [];
      container.innerHTML = equipment.map(name => `
        <button type="button" data-equipment-name="${escapeHTML(name)}"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 transition active:scale-95">
          <i data-lucide="${getEquipmentIcon(name)}" class="w-3.5 h-3.5 text-emerald-600"></i>
          + ${escapeHTML(name)}
        </button>
      `).join('');
      container.querySelectorAll('[data-equipment-name]').forEach(button => {
        button.addEventListener('click', () => toggleQuickEquipment(button.dataset.equipmentName));
      });
      lucide.createIcons();
    }

    function populateSchoolDataFields() {
      document.getElementById('setting-teachers').value = (settings.teachers || []).join('\n');
      document.getElementById('setting-classes').value = (settings.classes || []).join('\n');
      document.getElementById('setting-equipment').value = (settings.equipment || []).join('\n');
      renderSchoolDataList();
      const leadTime = document.getElementById('setting-lead-time');
      if ([...leadTime.options].some(option => option.value === String(settings.leadTimeMinutes))) {
        leadTime.value = String(settings.leadTimeMinutes);
      }
    }

    function updateSchoolData(category, value) {
      const settingKey = { teachers: 'teachers', classes: 'classes', equipment: 'equipment' }[category];
      if (!settingKey) return;
      const entries = value.split(/\r?\n/).map(item => item.trim()).filter(Boolean);
      settings[settingKey] = [...new Map(entries.map(item => [item.toLocaleLowerCase('pt-BR'), item])).values()];
      saveState();

      const status = document.getElementById('school-data-save-status');
      try {
        const saved = JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}');
        const storedEntries = saved[settingKey] || [];
        const didSave = JSON.stringify(storedEntries) === JSON.stringify(settings[settingKey]);
        status.textContent = didSave ? 'Alterações salvas automaticamente neste navegador.' : 'Não foi possível salvar. Verifique o espaço disponível.';
        status.className = `text-[11px] ${didSave ? 'text-emerald-700' : 'text-rose-600'}`;
      } catch (e) {
        status.textContent = 'Não foi possível salvar neste navegador.';
        status.className = 'text-[11px] text-rose-600';
      }

      populateTeacherOptions();
      populateClassOptions();
      renderQuickEquipmentChips();
      renderSchoolDataList();
    }

    function renderSchoolDataList() {
      const container = document.getElementById('school-data-list');
      if (!container) return;
      const groups = [
        { key: 'teachers', label: 'Professores' },
        { key: 'classes', label: 'Turmas' },
        { key: 'equipment', label: 'Equipamentos' }
      ];

      container.innerHTML = groups.map(group => {
        const items = settings[group.key] || [];
        const entries = items.length
          ? items.map((name, index) => `
              <li class="flex items-center justify-between gap-2 bg-white px-2.5 py-2 rounded-lg border border-slate-200">
                <span class="text-xs text-slate-700 break-words">${escapeHTML(name)}</span>
                <button type="button" data-delete-category="${group.key}" data-delete-index="${index}" aria-label="Excluir ${escapeHTML(name)} de ${group.label}" title="Excluir item" class="shrink-0 p-1.5 rounded-md text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </li>
            `).join('')
          : '<li class="text-xs text-slate-400 italic">Nenhum item cadastrado.</li>';
        return `<div><h5 class="text-[11px] font-bold text-slate-600 mb-1.5">${group.label} (${items.length})</h5><ul class="space-y-1.5">${entries}</ul></div>`;
      }).join('');

      container.querySelectorAll('[data-delete-category]').forEach(button => {
        button.addEventListener('click', () => removeSchoolData(button.dataset.deleteCategory, Number(button.dataset.deleteIndex)));
      });
      lucide.createIcons();
    }

    function removeSchoolData(category, index) {
      if (!['teachers', 'classes', 'equipment'].includes(category)) return;
      const values = settings[category];
      if (!Array.isArray(values) || index < 0 || index >= values.length) return;
      values.splice(index, 1);
      const fieldId = { teachers: 'setting-teachers', classes: 'setting-classes', equipment: 'setting-equipment' }[category];
      document.getElementById(fieldId).value = values.join('\n');
      saveState();
      populateTeacherOptions();
      populateClassOptions();
      renderQuickEquipmentChips();
      renderSchoolDataList();
    }

    function toggleQuickEquipment(name) {
      const existing = modalSelectedEquipments.find(item => item.name.toLowerCase() === name.toLowerCase());
      if (existing) {
        existing.qty += 1;
      } else {
        modalSelectedEquipments.push({ name, qty: 1 });
      }
      renderSelectedEquipmentsList();
    }

    function addCustomEquipment() {
      const input = document.getElementById('custom-equip-name');
      const val = input.value.trim();
      if (!val) return;
      toggleQuickEquipment(val);
      input.value = '';
    }

    function updateEquipmentQty(index, delta) {
      if (!modalSelectedEquipments[index]) return;
      modalSelectedEquipments[index].qty += delta;
      if (modalSelectedEquipments[index].qty <= 0) {
        modalSelectedEquipments.splice(index, 1);
      }
      renderSelectedEquipmentsList();
    }

    function setEquipmentQtyDirect(index, val) {
      const num = parseInt(val, 10);
      if (isNaN(num) || num <= 0) {
        modalSelectedEquipments.splice(index, 1);
      } else {
        modalSelectedEquipments[index].qty = num;
      }
      renderSelectedEquipmentsList();
    }

    function renderSelectedEquipmentsList() {
      const container = document.getElementById('selected-equipments-list');
      if (modalSelectedEquipments.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-400 text-center py-1.5">Toque nos botões acima para adicionar equipamentos.</p>`;
        return;
      }

      container.innerHTML = modalSelectedEquipments.map((item, idx) => `
        <div class="flex items-center justify-between bg-white px-3 py-2 rounded-xl border border-slate-200 shadow-2xs">
          <div class="flex items-center gap-2">
            <i data-lucide="${getEquipmentIcon(item.name)}" class="w-4 h-4 text-emerald-600"></i>
            <span class="text-xs font-semibold text-slate-800">${escapeHTML(item.name)}</span>
          </div>
          <div class="flex items-center gap-1.5">
            <button type="button" onclick="updateEquipmentQty(${idx}, -1)"
              class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm flex items-center justify-center">
              -
            </button>
            <input type="number" min="1" max="99" value="${item.qty}"
              onchange="setEquipmentQtyDirect(${idx}, this.value)"
              class="w-12 text-center text-xs font-bold border border-slate-200 rounded-lg py-1" />
            <button type="button" onclick="updateEquipmentQty(${idx}, 1)"
