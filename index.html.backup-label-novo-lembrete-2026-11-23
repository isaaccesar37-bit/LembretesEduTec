    function queueCloudSave() {
      if (!firebaseDb || !currentUser || !cloudSyncReady) return;
      clearTimeout(cloudSaveTimer);
      cloudSaveTimer = setTimeout(async () => {
        try {
          if (!currentUser || !cloudSyncReady) return;
          const snapshot = {
            bookings,
            settings,
            workshopFollowupRecords: readLocalArray('robotica_feedback_records_v1'),
            workshopClassTeachers: readLocalArray('robotica_class_teachers_v1'),
            updatedAt: firebase.firestore.FieldValue.serverTimestamp()
          };
          await firebaseDb.collection('users').doc(currentUser.uid)
            .collection('app').doc('state').set(snapshot);
          if (offlineSyncPendingUid === currentUser.uid) {
            offlineSyncPending = false;
            offlineSyncPendingUid = null;
          }
          authenticatedOfflineMode = false;
        } catch (error) {
          console.error('Erro ao sincronizar dados com Firebase:', error);
          if (isNetworkUnavailable(error) && currentUser) {
            offlineSyncPending = true;
            offlineSyncPendingUid = currentUser.uid;
            authenticatedOfflineMode = true;
          }
          if (!cloudErrorShown) {
            showToast('Não foi possível sincronizar com o banco de dados. Os dados permanecem salvos neste aparelho.', 'error');
            cloudErrorShown = true;
          }
        }
      }, 650);
    }

    function readLocalArray(key) {
      try {
        const value = JSON.parse(localStorage.getItem(key) || '[]');
