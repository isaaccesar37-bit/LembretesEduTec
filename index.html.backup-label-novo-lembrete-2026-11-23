      document.getElementById('workshop-date').value = getTodayISO();
      document.getElementById('workshop-save-label').textContent = 'Agendar oficina';
    }

    function saveWorkshop(event) {
      event.preventDefault();
      const id = document.getElementById('workshop-id').value;
      const date = document.getElementById('workshop-date').value;
      const grade = Number(document.getElementById('workshop-grade').value);
      const teacher = ROBOTICS_GRADE_TEACHERS[grade] || document.getElementById('workshop-teacher').value.trim();
      const slot = document.getElementById('workshop-slot').value;
      const notes = document.getElementById('workshop-notes').value.trim();
      const schedule = ROBOTICS_WORKSHOP_SLOTS[slot];
      if (!date || !teacher || !Number.isInteger(grade) || grade < 1 || grade > 9 || !schedule) return;
      const weekday = new Date(`${date}T12:00:00`).getDay();
      if (weekday < 1 || weekday > 5) {
        showToast('As oficinas podem ser agendadas de segunda a sexta-feira.', 'warning');
        return;
      }
      settings.workshops = Array.isArray(settings.workshops) ? settings.workshops : [];
      const startMinutes = Number(schedule.startTime.slice(0, 2)) * 60 + Number(schedule.startTime.slice(3));
      const endMinutes = Number(schedule.endTime.slice(0, 2)) * 60 + Number(schedule.endTime.slice(3));
      const overlaps = settings.workshops.some(item => {
        if (item.date !== date || item.id === id) return false;
        const existingStart = Number(item.startTime.slice(0, 2)) * 60 + Number(item.startTime.slice(3));
        const existingEnd = Number(item.endTime.slice(0, 2)) * 60 + Number(item.endTime.slice(3));
        return startMinutes < existingEnd && endMinutes > existingStart;
      });
      if (overlaps) {
        showToast('Já existe uma oficina marcada em horário sobreposto nessa data.', 'warning');
        return;
      }
      const workshopData = { date, teacher, grade, slot, startTime: schedule.startTime, endTime: schedule.endTime, notes };
      if (id) {
        const index = settings.workshops.findIndex(item => item.id === id);
        if (index < 0) return;
        settings.workshops[index] = { ...settings.workshops[index], ...workshopData };
        delete settings.notifiedEvents[`${id}_workshop_upcoming`];
        delete settings.notifiedEvents[`${id}_workshop_overdue`];
        showToast('Lembrete da oficina atualizado.', 'success');
      } else {
        settings.workshops.push({
          id: 'ws_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
          ...workshopData,
          status: 'pending'
        });
        showToast('Lembrete da oficina adicionado.', 'success');
      }
      saveState();
      resetWorkshopForm();
      document.getElementById('workshop-registration-panel').classList.add('hidden');
      renderWorkshops();
    }

    function editWorkshop(id) {
      const workshop = (settings.workshops || []).find(item => item.id === id);
      if (!workshop) return;
      document.getElementById('workshop-registration-panel').classList.remove('hidden');
      document.getElementById('workshop-id').value = workshop.id;
      document.getElementById('workshop-date').value = workshop.date;
      document.getElementById('workshop-grade').value = String(workshop.grade);
      handleWorkshopGradeChange();
      if (!ROBOTICS_GRADE_TEACHERS[Number(workshop.grade)]) document.getElementById('workshop-teacher').value = workshop.teacher;
      document.getElementById('workshop-slot').value = workshop.slot;
      document.getElementById('workshop-notes').value = workshop.notes || '';
      document.getElementById('workshop-save-label').textContent = 'Salvar alterações';
      document.getElementById('workshop-cancel-edit').classList.remove('hidden');
      document.getElementById('workshop-date').focus();
      document.getElementById('workshop-form').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function setWorkshopStatus(id, status) {
      const workshop = (settings.workshops || []).find(item => item.id === id);
      if (!workshop || !['pending', 'started', 'completed'].includes(status)) return;

      const applyStatus = () => {
        const currentWorkshop = (settings.workshops || []).find(item => item.id === id);
        if (!currentWorkshop) return;
        currentWorkshop.status = status;
        if (status === 'pending') {
          delete settings.notifiedEvents[`${id}_workshop_upcoming`];
          delete settings.notifiedEvents[`${id}_workshop_overdue`];
        }
        saveState();
        renderWorkshops();
        const messages = { pending: 'Oficina reaberta.', started: 'Oficina iniciada.', completed: 'Oficina concluída.' };
        showToast(messages[status], 'success');
      };

      if (['started', 'completed'].includes(status) && !isWithinConfirmationWindow(workshop.date, workshop.startTime)) {
        const isStarting = status === 'started';
        openConfirmModal(
          isStarting ? 'Confirmar início da oficina?' : 'Confirmar conclusão da oficina?',
          isStarting
            ? `Confirma o início da oficina do ${workshop.grade}º Ano em ${formatDateBR(workshop.date)}?`
            : `Confirma que a oficina do ${workshop.grade}º Ano em ${formatDateBR(workshop.date)} foi concluída?`,
          applyStatus
        );
        return;
      }
      applyStatus();
    }

    function confirmDeleteWorkshop(id) {
      const workshop = (settings.workshops || []).find(item => item.id === id);
      if (!workshop) return;
      openConfirmModal(
        'Excluir lembrete da oficina?',
        `O lembrete do ${workshop.grade}º Ano em ${formatDateBR(workshop.date)} será removido da agenda.`,
        () => {
          settings.workshops = settings.workshops.filter(item => item.id !== id);
          Object.keys(settings.notifiedEvents || {}).forEach(key => {
            if (key.startsWith(`${id}_`)) delete settings.notifiedEvents[key];
          });
          saveState();
          renderWorkshops();
          showToast('Lembrete da oficina excluído.', 'info');
        }
      );
    }

