    function isNetworkUnavailable(error) {
      return !navigator.onLine || ['unavailable', 'deadline-exceeded', 'network-request-failed', 'auth/network-request-failed'].includes(error?.code);
    }

    // Cada usuário tem um documento privado no Firestore, identificado pelo UID do Firebase.
    async function activateAuthenticatedUser(user) {
      currentUser = user;
      cloudSyncReady = false;
      cloudErrorShown = false;
      setLoginStatus('Carregando seus dados…');
      const stateRef = firebaseDb.collection('users').doc(user.uid).collection('app').doc('state');
      let savedState = null;
      let offlineMode = false;
      try {
        savedState = await stateRef.get();
        offlineMode = !navigator.onLine;
        if (offlineMode) authenticatedOfflineMode = true;
      } catch (error) {
        const localOwner = localStorage.getItem(LOCAL_USER_KEY);
        if (!isNetworkUnavailable(error) || localOwner !== user.uid) throw error;
        bookings = [];
        settings = createDefaultSettings();
        loadState();
        ensureProfessorSchedule();
        normalizeSchoolCatalogs();
        offlineMode = true;
        authenticatedOfflineMode = true;
      }
      let scheduleNeedsMigration = false;

      if (savedState?.exists) {
        const data = savedState.data() || {};
        bookings = Array.isArray(data.bookings) ? data.bookings : [];
        settings = { ...createDefaultSettings(), ...(data.settings || {}) };
        if (Array.isArray(data.workshopFollowupRecords)) localStorage.setItem('robotica_feedback_records_v1', JSON.stringify(data.workshopFollowupRecords));
        if (Array.isArray(data.workshopClassTeachers)) localStorage.setItem('robotica_class_teachers_v1', JSON.stringify(data.workshopClassTeachers));
        normalizeRoboticsWorkshopTeachers();
        scheduleNeedsMigration = !Array.isArray(data.settings?.professorSchedule) || !Array.isArray(data.settings?.professorNames)
          || !Array.isArray(data.workshopFollowupRecords) || !Array.isArray(data.workshopClassTeachers);
      } else if (!offlineMode) {
        const localOwner = localStorage.getItem(LOCAL_USER_KEY);
        const legacyEmail = LEGACY_SUPABASE_ACCOUNT_EMAILS[localOwner];
        const canImportLocalCache = !localOwner || localOwner === user.uid || legacyEmail === (user.email || '').toLowerCase();
        if (canImportLocalCache) {
          bookings = [];
          settings = createDefaultSettings();
          loadState();
        } else {
          bookings = [];
          settings = createDefaultSettings();
        }
        ensureProfessorSchedule();
        normalizeSchoolCatalogs();
        await stateRef.set({
          bookings,
          settings,
          workshopFollowupRecords: readLocalArray('robotica_feedback_records_v1'),
          workshopClassTeachers: readLocalArray('robotica_class_teachers_v1'),
          updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        });
      }

      ensureProfessorSchedule();
      persistLocalState();
      cloudSyncReady = true;
      if (scheduleNeedsMigration) queueCloudSave();
      document.getElementById('signed-in-user').textContent = user.displayName || user.email || 'Usuário conectado';
      document.getElementById('login-screen').classList.add('hidden');
      document.getElementById('app-shell').classList.remove('hidden');
      updateHeaderControls();
      populateTeacherOptions();
      populateClassOptions();
      refreshProfessorLocatorOptions();
      renderQuickEquipmentChips();
      updateClockAndMonitor();
      setLoginStatus(offlineMode ? 'Acesso offline. Os dados deste aparelho estarão disponíveis até a conexão voltar.' : 'Acesso realizado.', offlineMode ? 'warning' : 'success');
      if (offlineMode) showToast('Modo offline: alterações ficam neste aparelho e serão sincronizadas quando a conexão voltar.', 'warning');

      if (!monitorIntervalStarted) {
        monitorIntervalStarted = true;
        setInterval(updateClockAndMonitor, 5000);
      }
    }

    async function handleLogin(event) {
      event.preventDefault();
      if (!firebaseAuth) {
        setLoginStatus('O Firebase ainda não foi configurado neste app.', 'warning');
        return;
      }

      const email = document.getElementById('login-email').value.trim().toLowerCase();
      const password = document.getElementById('login-password').value;
      const button = document.getElementById('login-submit');
      button.disabled = true;
      setLoginStatus('Verificando acesso…');

      try {
        await firebaseAuth.signInWithEmailAndPassword(email, password);
      } catch (error) {
        console.error('Falha no login:', error);
        const messages = {
          'auth/invalid-credential': 'E-mail ou senha incorretos.',
          'auth/user-not-found': 'Não existe uma conta do Firebase com esse e-mail.',
          'auth/wrong-password': 'E-mail ou senha incorretos.',
          'auth/too-many-requests': 'Muitas tentativas. Aguarde um pouco e tente novamente.',
          'auth/operation-not-allowed': 'Ative o acesso por e-mail e senha nas configurações de Authentication do Firebase.',
          'auth/network-request-failed': 'Sem conexão. A conta precisa ter sido autenticada online antes neste aparelho para abrir os dados offline.'
        };
        setLoginStatus(messages[error.code] || error.message || 'Não foi possível entrar. Confira o e-mail e a senha.', 'error');
      } finally {
        button.disabled = false;
      }
    }

    async function signOut() {
      if (localAdminMode || !firebaseAuth) {
        lockApplication();
        setLoginStatus('Acesso local encerrado.');
        return;
      }
      try {
        await firebaseAuth.signOut();
      } catch (error) {
        console.error('Falha ao encerrar sessão do Firebase:', error);
        showToast('Não foi possível encerrar a sessão.', 'error');
        return;
      }
      lockApplication();
      setLoginStatus('Sessão encerrada.');
    }

    async function initializeAuthentication() {
      const configured = FIREBASE_CONFIG.apiKey && !FIREBASE_CONFIG.apiKey.startsWith('COLE_')
        && FIREBASE_CONFIG.authDomain && !FIREBASE_CONFIG.authDomain.startsWith('COLE_')
        && FIREBASE_CONFIG.projectId && !FIREBASE_CONFIG.projectId.startsWith('COLE_')
        && FIREBASE_CONFIG.appId && !FIREBASE_CONFIG.appId.startsWith('COLE_');
      if (!configured || !window.firebase?.initializeApp || !window.firebase?.firestore) {
        setLoginStatus('Configure os dados do aplicativo Firebase neste arquivo para ativar o login.', 'warning');
        document.getElementById('login-submit').disabled = true;
        lucide.createIcons();
        return;
      }

      try {
        firebase.initializeApp(FIREBASE_CONFIG);
        firebaseAuth = firebase.auth();
        firebaseDb = firebase.firestore();
      } catch (error) {
        console.error('Falha ao iniciar Firebase:', error);
        setLoginStatus('Não foi possível iniciar o Firebase. Confira a configuração do app.', 'error');
        return;
      }

      try {
        await firebaseDb.enablePersistence({ synchronizeTabs: true });
      } catch (persistenceError) {
        console.warn('O cache persistente do Firestore não pôde ser ativado neste navegador:', persistenceError);
      }

      firebaseAuth.onAuthStateChanged(async (user) => {
        if (!user) {
          if (currentUser) lockApplication();
          setLoginStatus('Informe o e-mail e a senha cadastrados no Firebase.');
          return;
        }
        try {
          await activateAuthenticatedUser(user);
        } catch (authError) {
          console.error('Erro ao abrir os dados do usuário no Firebase:', authError);
          if (isNetworkUnavailable(authError)) {
            setLoginStatus(localStorage.getItem(LOCAL_USER_KEY) === user.uid
              ? 'Sem conexão. Os dados offline estarão disponíveis se esta conta já foi usada neste aparelho.'
              : 'Conecte-se à internet e abra esta conta neste aparelho pelo menos uma vez.', 'warning');
            return;
          }
          setLoginStatus(authError.message || 'Não foi possível acessar seus dados no Firebase.', 'error');
          await firebaseAuth.signOut();
        }
      });
      window.addEventListener('online', () => {
        const user = firebaseAuth?.currentUser;
        if (!user) return;
        cloudErrorShown = false;
        if (offlineSyncPending && offlineSyncPendingUid === user.uid && cloudSyncReady) queueCloudSave();
        else if (!cloudSyncReady || authenticatedOfflineMode) {
          activateAuthenticatedUser(user).catch(error => {
            console.error('Não foi possível retomar a sincronização:', error);
            setLoginStatus('A conexão voltou, mas a sincronização ainda não foi concluída.', 'warning');
          });
        }
      });
      lucide.createIcons();
    }

    // =========================================================================
    // INICIALIZAÇÃO DA APLICAÇÃO
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      initializeProfessorLocator();
      initializeAuthentication();

      if ('serviceWorker' in navigator && window.isSecureContext) {
        let refreshingForUpdate = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (refreshingForUpdate) return;
          refreshingForUpdate = true;
          window.location.reload();
        });
        navigator.serviceWorker.register('./service-worker.js', { updateViaCache: 'none' })
          .then(registration => registration.update())
          .catch((error) => console.warn('Não foi possível atualizar o app:', error));
      }

      // Atualiza o relógio e verifica prazos a cada 5 segundos
      setInterval(updateClockAndMonitor, 5000);
      setInterval(() => {
        const professorView = document.getElementById('professor-view');
        if (professorLocatorFollowsCurrent && professorView && !professorView.classList.contains('hidden')) {
          updateProfessorLocatorTime();
        }
      }, 30000);
    });
