    function updateProfessorLocatorTime(now = new Date()) {
      const daySelect = document.getElementById('professor-day');
      const timeSelect = document.getElementById('professor-time');
      if (!daySelect || !timeSelect) return;

      const weekday = now.getDay();
      professorScheduleIsWeekend = weekday === 0 || weekday === 6;
      daySelect.value = String(professorScheduleIsWeekend ? 0 : weekday - 1);
      const currentMinutes = now.getHours() * 60 + now.getMinutes();
      const currentTime = PROFESSOR_TIME_OPTIONS.find(time => {
        const [start, end] = time.split('-').map(value => {
          const [hours, minutes] = value.split(':').map(Number);
          return hours * 60 + minutes;
        });
        return currentMinutes >= start && currentMinutes < end;
      });
      timeSelect.value = currentTime || '';
      renderProfessorLocator();
    }

