          ` : `
            <button onclick="advanceStatus('${next.id}', 'completed')"
              class="w-full sm:w-auto px-4 py-2.5 bg-sky-400 hover:bg-sky-300 text-slate-950 font-bold text-xs sm:text-sm rounded-xl shadow-md transition flex items-center justify-center gap-2">
              <i data-lucide="archive" class="w-4 h-4"></i>
              Confirmar Recolhimento
            </button>
          `}
        </div>
      `;

      wrapper.classList.remove('hidden');
    }

