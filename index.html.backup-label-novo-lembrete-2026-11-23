    function readWorkshopPedagogicalData() {
      const readArray = key => {
        try {
          const value = JSON.parse(localStorage.getItem(key) || '[]');
          return Array.isArray(value) ? value : [];
        } catch (error) {
          console.warn('Não foi possível ler os dados pedagógicos locais:', error);
          return [];
        }
      };
      const records = readArray('robotica_feedback_records_v1');
      const savedPairs = readArray('robotica_class_teachers_v1');
      const classes = new Map();
      const addClass = (className, teacher = '') => {
        const name = String(className || '').trim();
        if (!name) return;
        const key = name.toLocaleLowerCase('pt-BR');
        const previous = classes.get(key);
        classes.set(key, { className: previous?.className || name, teacher: teacher || previous?.teacher || '' });
      };
      (settings.classes || []).forEach(name => addClass(name));
      savedPairs.forEach(item => addClass(item.className, item.teacher));
      records.forEach(record => addClass(record.className, record.teacher));
      return { records, classes: [...classes.values()] };
    }

    function renderWorkshopPedagogicalProgress() {
      const { records, classes } = readWorkshopPedagogicalData();
      const year = new Date().getFullYear();
      const yearRecords = records.filter(record => {
        const date = new Date(`${record.date || ''}T12:00:00`);
        return Number.isFinite(date.getTime()) && date.getFullYear() === year;
      });
      const gradeOptions = ['ALL', ...Array.from({ length: 9 }, (_, index) => `${index + 1}º Ano`)];
      const filter = document.getElementById('workshop-progress-grade-filters');
      filter.innerHTML = gradeOptions.map(grade => `<button type="button" data-progress-grade="${grade}" aria-pressed="${workshopProgressGradeFilter === grade}" class="shrink-0 rounded-xl border px-3 py-2 text-xs font-semibold transition ${workshopProgressGradeFilter === grade ? 'border-emerald-600 bg-emerald-600 text-white' : 'border-slate-200 bg-white text-slate-600 hover:bg-emerald-50 hover:text-emerald-700'}">${grade === 'ALL' ? 'Todas as séries' : grade}</button>`).join('');
      filter.querySelectorAll('[data-progress-grade]').forEach(button => button.addEventListener('click', () => {
        workshopProgressGradeFilter = button.dataset.progressGrade;
        renderWorkshopPedagogicalProgress();
      }));

      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const progress = classes.map(entry => {
        const classRecords = yearRecords.filter(record => String(record.className || '').toLocaleLowerCase('pt-BR') === entry.className.toLocaleLowerCase('pt-BR'));
        const gradeNumber = Number((entry.className.match(/(?:^|\D)([1-9])/ ) || [])[1] || 0);
        const targetCount = gradeNumber >= 6 ? 22 : 18;
        const completedWorkshops = [...new Set(classRecords.map(record => Number(record.workshopNum)).filter(number => Number.isInteger(number) && number >= 1 && number <= targetCount))];
        const lastRecord = [...classRecords].sort((a, b) => String(b.date).localeCompare(String(a.date)))[0];
        const lastDate = lastRecord ? new Date(`${lastRecord.date}T12:00:00`) : null;
        const daysSince = lastDate ? Math.max(0, Math.floor((today - lastDate) / 86400000)) : null;
        return { ...entry, gradeNumber, targetCount, classRecords, completed: completedWorkshops.length, percentage: Math.min(100, Math.round(completedWorkshops.length / targetCount * 100)), lastRecord, daysSince };
      }).filter(entry => workshopProgressGradeFilter === 'ALL' || `${entry.gradeNumber}º Ano` === workshopProgressGradeFilter);

      const alertCount = progress.filter(entry => entry.daysSince !== null && entry.daysSince > 15).length;
      const average = progress.length ? Math.round(progress.reduce((sum, entry) => sum + entry.percentage, 0) / progress.length) : 0;
      document.getElementById('workshop-progress-alert-count').textContent = alertCount;
      document.getElementById('workshop-progress-average').textContent = `${average}%`;
      document.getElementById('workshop-progress-empty').classList.toggle('hidden', progress.length > 0);
      const cards = document.getElementById('workshop-progress-cards');
      cards.innerHTML = progress.map(entry => {
        const isAlert = entry.daysSince !== null && entry.daysSince > 15;
        const status = entry.daysSince === null ? 'Aguardando primeiro registro' : isAlert ? `${entry.daysSince}d sem aula` : `Em dia (${entry.daysSince}d)`;
        const statusClass = entry.daysSince === null ? 'bg-amber-50 text-amber-700' : isAlert ? 'bg-rose-50 text-rose-700' : 'bg-emerald-50 text-emerald-700';
        const teacher = entry.teacher || entry.lastRecord?.teacher || 'Professor(a) não informado(a)';
        return `<article class="rounded-2xl border ${isAlert ? 'border-rose-300' : 'border-slate-200'} bg-white p-4 shadow-sm">
          <div class="flex items-start justify-between gap-2"><div class="min-w-0"><div class="flex flex-wrap items-center gap-1.5"><h3 class="font-bold text-slate-900">${escapeHTML(entry.className)}</h3><span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700">${entry.gradeNumber ? `${entry.gradeNumber}º Ano` : 'Turma'}</span></div><p class="mt-1 truncate text-xs text-slate-500">Prof.ª ${escapeHTML(teacher)}</p></div><span class="shrink-0 rounded-full px-2 py-1 text-[10px] font-bold ${statusClass}">${isAlert ? '<i data-lucide="triangle-alert" class="mr-1 inline-block h-3 w-3 align-[-2px]"></i>' : ''}${status}</span></div>
          <div class="mt-4 flex items-center justify-between text-xs"><span class="font-medium text-slate-600">Progresso anual</span><span class="font-bold text-emerald-700">${entry.completed} / ${entry.targetCount} oficinas (${entry.percentage}%)</span></div>
          <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full ${isAlert ? 'bg-amber-400' : 'bg-emerald-600'}" style="width:${entry.percentage}%"></div></div>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-3 text-[10px] text-slate-500"><span>${entry.lastRecord ? `Última: ${formatDateBR(entry.lastRecord.date)}` : 'Ainda sem oficina neste ano'}</span><button type="button" data-progress-class="${escapeHTML(entry.className)}" data-progress-teacher="${escapeHTML(teacher)}" class="font-bold text-emerald-700 hover:text-emerald-900">+ Nova Oficina</button></div>
        </article>`;
      }).join('');
      cards.querySelectorAll('[data-progress-class]').forEach(button => button.addEventListener('click', () => openPedagogicalWorkshopRecord(button.dataset.progressClass, button.dataset.progressTeacher)));
      lucide.createIcons();
    }

    function openPedagogicalWorkshopRecord(className, teacher) {
      const frame = document.getElementById('workshop-followup-frame');
      const openForm = () => {
        const childWindow = frame.contentWindow;
        const childDocument = frame.contentDocument;
        if (!childWindow || !childDocument || typeof childWindow.switchTab !== 'function') return;
        childWindow.switchTab('register');
        const classSelect = childDocument.getElementById('inp-class');
        if (![...classSelect.options].some(option => option.value === className)) classSelect.add(new Option(className, className));
        classSelect.value = className;
        childWindow.handleClassInput();
        if (teacher) childDocument.getElementById('inp-teacher').value = teacher;
        const { records } = readWorkshopPedagogicalData();
        const gradeNumber = Number((className.match(/(?:^|\D)([1-9])/ ) || [])[1] || 0);
        const targetCount = gradeNumber >= 6 ? 22 : 18;
        const used = new Set(records.filter(record => record.className === className && new Date(`${record.date || ''}T12:00:00`).getFullYear() === new Date().getFullYear()).map(record => Number(record.workshopNum)));
        const nextWorkshop = Array.from({ length: targetCount }, (_, index) => index + 1).find(number => !used.has(number)) || targetCount;
        childDocument.getElementById('inp-workshop-num').value = String(nextWorkshop);
        childWindow.syncWorkshopDetails();
        childDocument.getElementById('inp-date').valueAsDate = new Date();
      };
      if (!frame.dataset.loaded) {
        frame.addEventListener('load', openForm, { once: true });
        switchWorkshopSection('reports');
      } else {
        switchWorkshopSection('reports');
        window.setTimeout(openForm, 50);
      }
    }

    function switchWorkshopView(view) {
      const showCalendar = view === 'calendar';
      const agendaPanel = document.getElementById('workshop-agenda-panel');
      const calendarPanel = document.getElementById('workshop-calendar-panel');
      const agendaTab = document.getElementById('workshop-agenda-tab');
      const calendarTab = document.getElementById('workshop-calendar-tab');
      agendaPanel.classList.toggle('hidden', showCalendar);
      calendarPanel.classList.toggle('hidden', !showCalendar);
      agendaTab.setAttribute('aria-selected', String(!showCalendar));
      calendarTab.setAttribute('aria-selected', String(showCalendar));
      agendaTab.className = 'rounded-xl px-4 py-2 text-sm font-semibold ' + (showCalendar ? 'bg-slate-100 text-slate-600 hover:bg-emerald-50 hover:text-emerald-700' : 'bg-emerald-600 text-white');
      calendarTab.className = 'rounded-xl px-4 py-2 text-sm font-semibold ' + (showCalendar ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-600 hover:bg-emerald-50 hover:text-emerald-700');
      if (showCalendar) renderWorkshopCalendar();
    }

    function changeWorkshopCalendarMonth(amount) {
      workshopCalendarDate = new Date(workshopCalendarDate.getFullYear(), workshopCalendarDate.getMonth() + amount, 1);
      renderWorkshopCalendar();
    }

    function localDateToISO(date) {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }

    function selectWorkshopCalendarDate(date) {
      document.getElementById('workshop-date').value = date;
      switchWorkshopView('agenda');
      document.getElementById('workshop-grade').focus();
      document.getElementById('workshop-form').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function renderWorkshopCalendar() {
      const title = document.getElementById('workshop-calendar-title');
      const grid = document.getElementById('workshop-calendar-grid');
      if (!title || !grid) return;
      title.textContent = workshopCalendarDate.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
      const year = workshopCalendarDate.getFullYear();
      const month = workshopCalendarDate.getMonth();
      const firstDay = new Date(year, month, 1);
      const mondayOffset = (firstDay.getDay() + 6) % 7;
      const gridStart = new Date(year, month, 1 - mondayOffset);
      const weekCount = Math.ceil((mondayOffset + new Date(year, month + 1, 0).getDate()) / 7);
      const today = getTodayISO();
      const workshops = settings.workshops || [];
      const rows = [];
      for (let week = 0; week < weekCount; week++) {
        const cells = [];
        for (let weekday = 0; weekday < 5; weekday++) {
          const cellDate = new Date(gridStart.getFullYear(), gridStart.getMonth(), gridStart.getDate() + week * 7 + weekday);
          const dateISO = localDateToISO(cellDate);
          const inMonth = cellDate.getMonth() === month;
          const dayWorkshops = workshops.filter(item => item.date === dateISO).sort((a, b) => a.startTime.localeCompare(b.startTime));
          const eventHTML = dayWorkshops.length
            ? dayWorkshops.map(item => `<div class="mt-1 rounded-lg px-1.5 py-1 text-left text-[10px] leading-tight ${item.status === 'completed' ? 'bg-emerald-100 text-emerald-800' : 'bg-emerald-100 text-emerald-900'}"><b>${escapeHTML(item.grade)}º Ano</b><br>${escapeHTML(item.startTime)} · ${escapeHTML(item.teacher)}</div>`).join('')
            : '<span class="mt-1 block text-[10px] text-slate-300">—</span>';
          cells.push(`<div class="min-h-[112px] rounded-xl border ${inMonth ? 'border-slate-200 bg-white' : 'border-slate-100 bg-slate-50/70'} p-1.5 sm:p-2"><button type="button" onclick="selectWorkshopCalendarDate('${dateISO}')" class="flex h-6 w-6 items-center justify-center rounded-full text-xs font-bold ${dateISO === today ? 'bg-emerald-600 text-white' : inMonth ? 'text-slate-700 hover:bg-emerald-50' : 'text-slate-300 hover:bg-slate-100'}" aria-label="Adicionar oficina em ${dateISO}">${cellDate.getDate()}</button>${eventHTML}</div>`);
        }
        rows.push(`<div class="grid grid-cols-5 gap-1.5">${cells.join('')}</div>`);
      }
      grid.innerHTML = rows.join('');
      lucide.createIcons();
    }

    function renderWorkshops() {
      const list = document.getElementById('workshops-list');
      if (!list) return;
      const dayNames = ['domingo', 'segunda-feira', 'terça-feira', 'quarta-feira', 'quinta-feira', 'sexta-feira', 'sábado'];
      const items = [...(settings.workshops || [])].sort((a, b) => `${a.date}T${a.startTime}`.localeCompare(`${b.date}T${b.startTime}`));
      document.getElementById('workshop-count').textContent = items.length;
      document.getElementById('workshops-empty').classList.toggle('hidden', items.length > 0);
      list.innerHTML = items.map(workshop => {
        const started = workshop.status === 'started';
        const completed = workshop.status === 'completed';
        const start = parseDateTime(workshop.date, workshop.startTime);
        const diff = start.getTime() - Date.now();
        const lead = Number(settings.leadTimeMinutes || 15) * 60000;
        const timing = completed ? 'Concluída' : started ? 'Iniciada' : diff < 0 ? `Atrasada há ${formatMinutesDiff(diff)}` : diff <= lead ? `Começa em ${formatMinutesDiff(diff)}` : 'Agendada';
        const timingClass = completed ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : diff < 0 ? 'bg-rose-50 text-rose-700 border-rose-200' : diff <= lead ? 'bg-amber-50 text-amber-800 border-amber-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200';
        const teacher = ROBOTICS_GRADE_TEACHERS[Number(workshop.grade)] || workshop.teacher;
        return `<article class="rounded-2xl border ${completed ? 'border-slate-200 opacity-75' : 'border-slate-200'} bg-white p-3.5 sm:p-4 shadow-sm">
          <div class="flex items-center justify-between gap-2">
            <div class="flex min-w-0 flex-wrap items-center gap-1.5"><span class="rounded-lg bg-emerald-50 px-2.5 py-1 text-[11px] font-bold text-emerald-700">${escapeHTML(workshop.grade)}º Ano</span><span class="rounded-md bg-slate-100 px-2 py-1 text-[10px] font-semibold text-slate-600">${escapeHTML(Number(workshop.grade) <= 5 ? 'EF I' : 'EF II')}</span></div>
            <span class="shrink-0 rounded-full px-2.5 py-1 text-[10px] font-bold ${completed || started ? 'bg-emerald-50 text-emerald-700' : diff < 0 ? 'bg-rose-50 text-rose-700' : diff <= lead ? 'bg-amber-50 text-amber-800' : 'bg-amber-50 text-amber-800'}">${escapeHTML(timing)}</span>
          </div>
          <h4 class="mt-2 truncate text-sm font-bold text-slate-900">Oficina de Robótica · ${escapeHTML(ROBOTICS_WORKSHOP_SLOTS[workshop.slot]?.label || 'Dois horários')}</h4>
          <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] text-slate-500"><span><i data-lucide="user-round" class="mr-1 inline-block h-3 w-3 align-[-2px]"></i>${escapeHTML(teacher)}</span><span><i data-lucide="calendar-days" class="mr-1 inline-block h-3 w-3 align-[-2px]"></i>${formatDateBR(workshop.date)} às ${escapeHTML(workshop.startTime)}</span></p>
          <p class="mt-2 min-h-8 rounded-lg bg-slate-50 px-2.5 py-2 text-[10px] leading-snug text-slate-600">${escapeHTML(workshop.notes || 'Oficina de robótica.')}</p>
          <div class="mt-2 flex items-center justify-end gap-1.5 border-t border-slate-100 pt-2">
            ${!started && !completed ? `<button type="button" onclick="setWorkshopStatus('${workshop.id}', 'started')" class="rounded-lg border border-emerald-200 bg-white px-3 py-1.5 text-[10px] font-bold text-emerald-700 hover:bg-emerald-50">Iniciada</button>` : ''}
            <button type="button" onclick="setWorkshopStatus('${workshop.id}', '${completed ? 'pending' : 'completed'}')" class="rounded-lg px-3 py-1.5 text-[10px] font-bold ${completed ? 'bg-slate-100 text-slate-700 hover:bg-slate-200' : 'bg-emerald-600 text-white hover:bg-emerald-700'}">${completed ? 'Reabrir' : 'Concluida'}</button>
            <button type="button" onclick="editWorkshop('${workshop.id}')" aria-label="Editar lembrete da oficina" class="rounded-lg border border-slate-200 p-1.5 text-slate-500 hover:bg-emerald-50 hover:text-emerald-700"><i data-lucide="pencil" class="h-3.5 w-3.5"></i></button>
            <button type="button" onclick="confirmDeleteWorkshop('${workshop.id}')" aria-label="Excluir lembrete da oficina" class="rounded-lg border border-transparent p-1.5 text-rose-500 hover:bg-rose-50"><i data-lucide="trash-2" class="h-3.5 w-3.5"></i></button>
          </div>
        </article>`;
      }).join('');
      lucide.createIcons();
      if (!document.getElementById('workshop-calendar-panel').classList.contains('hidden')) renderWorkshopCalendar();
    }

    function renderNextActionCard(now) {
      const wrapper = document.getElementById('next-action-wrapper');
      const card = document.getElementById('next-action-card');

      const activeBookings = bookings.filter(b => b.status !== 'completed');
      if (activeBookings.length === 0) {
        wrapper.classList.add('hidden');
        return;
      }

      // Encontra o compromisso ativo mais urgente/próximo
      activeBookings.sort((a, b) => {
        const dtA = a.status === 'pending' ? parseDateTime(a.date, a.deliveryTime) : parseDateTime(a.date, a.pickupTime);
        const dtB = b.status === 'pending' ? parseDateTime(b.date, b.deliveryTime) : parseDateTime(b.date, b.pickupTime);
        return dtA - dtB;
      });

      const next = activeBookings[0];
      const isPending = next.status === 'pending';
      const targetTimeStr = isPending ? next.deliveryTime : next.pickupTime;
      const targetDate = parseDateTime(next.date, targetTimeStr);
      const diffMs = targetDate.getTime() - now.getTime();
      const isOverdue = diffMs < 0;

      const badgeText = isPending ? 'PRÓXIMA ENTREGA' : 'PRÓXIMO RECOLHIMENTO';
      const timeStatusText = isOverdue
        ? `Atrasado há ${formatMinutesDiff(diffMs)}`
        : `Em ${formatMinutesDiff(diffMs)}`;

      const equipSummary = next.equipments.map(e => `${e.qty}x ${e.name}`).join(', ');

      card.innerHTML = `
        <div class="space-y-1.5">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full ${isOverdue ? 'bg-rose-500 text-white' : 'bg-amber-400 text-slate-900'}">
              ${badgeText}
            </span>
            <span class="text-xs font-semibold text-emerald-200 flex items-center gap-1">
              <i data-lucide="clock" class="w-3.5 h-3.5"></i>
              ${formatDateBR(next.date)} às <strong class="text-white text-sm">${targetTimeStr}</strong> (${timeStatusText})
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-white">
            ${escapeHTML(next.teacher)} <span class="text-emerald-300 font-medium">• ${escapeHTML(next.className)}</span>
          </h3>
          <p class="text-xs sm:text-sm text-emerald-100 flex items-center gap-1.5">
            <i data-lucide="package" class="w-4 h-4 text-emerald-300 shrink-0"></i>
            <span>${escapeHTML(equipSummary)}${next.notes ? ` — <em class="text-emerald-200">${escapeHTML(next.notes)}</em>` : ''}</span>
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          ${isPending ? `
            <button onclick="advanceStatus('${next.id}', 'in_use')"
              class="w-full sm:w-auto px-4 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs sm:text-sm rounded-xl shadow-md transition flex items-center justify-center gap-2">
              <i data-lucide="check-circle" class="w-4 h-4"></i>
