    async function handleForgotPassword(event) {
      event.preventDefault();
      if (!firebaseAuth) {
        setForgotPasswordStatus('O serviço de autenticação ainda não está disponível.', 'error');
        return;
      }

      const email = document.getElementById('recovery-email').value.trim();
      const button = document.getElementById('forgot-password-submit');
      button.disabled = true;
      setForgotPasswordStatus('Solicitando o link de recuperação…');
      try {
        const continueUrl = `${window.location.origin}${window.location.pathname}`;
        await firebaseAuth.sendPasswordResetEmail(email, { url: continueUrl, handleCodeInApp: false });
        setForgotPasswordStatus('Se esse e-mail estiver cadastrado, você receberá um link para redefinir a senha.', 'success');
      } catch (error) {
        const messages = {
          'auth/too-many-requests': 'Muitas tentativas. Aguarde antes de solicitar outro e-mail.',
          'auth/invalid-email': 'Confira o formato do e-mail informado.',
          'auth/operation-not-allowed': 'Ative o acesso por e-mail e senha nas configurações de Authentication do Firebase.',
          'auth/user-not-found': 'Não encontramos uma conta com esse e-mail.'
        };
        setForgotPasswordStatus(messages[error.code] || error.message || 'Não foi possível enviar o link de recuperação.', 'error');
      } finally {
        button.disabled = false;
      }
    }

