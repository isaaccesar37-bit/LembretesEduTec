    function handleWorkshopGradeChange() {
      const grade = Number(document.getElementById('workshop-grade').value);
      const teacher = document.getElementById('workshop-teacher');
      const assignedTeacher = ROBOTICS_GRADE_TEACHERS[grade];
      teacher.readOnly = Boolean(assignedTeacher);
      teacher.value = assignedTeacher || '';
      teacher.placeholder = assignedTeacher ? '' : 'Informe o nome da professora';
      teacher.classList.toggle('bg-slate-100', Boolean(assignedTeacher));
