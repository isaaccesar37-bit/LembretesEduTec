<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#065f46" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="manifest.webmanifest" />
  <link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png" />
  <link rel="apple-touch-icon" href="icons/icon-192.png" />
  <title>LembretesEduTec — Lembretes escolares</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Firebase Web SDK: autenticação e banco de dados -->
  <script src="https://www.gstatic.com/firebasejs/13.3.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/13.3.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/13.3.0/firebase-firestore-compat.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            brand: {
              50: '#ecfdf5',
              100: '#d1fae5',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              900: '#064e3b',
            }
          }
        }
      }
    };
  </script>
  <style>
    /* Suavização de rolagem e ajustes visuais finos */
    html {
      scroll-behavior: smooth;
    }
    @keyframes pulse-border {
      0%, 100% { border-color: rgba(239, 68, 68, 0.9); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.3); }
      50% { border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    }
    .animate-urgent {
      animation: pulse-border 2s infinite;
    }
    /* Custom scrollbar discreta */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
    .login-layout { min-height: 100vh; }
    .login-intro { background: linear-gradient(145deg, #059669 0%, #047857 55%, #065f46 100%); }
    .login-card-zone { background: #f8fafc; }
    #app-shell.app-layout:not(.hidden) {
      display: grid !important;
      grid-template-columns: 248px minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      min-height: 100vh;
      align-items: start;
    }
    #app-sidebar {
      grid-column: 1;
      grid-row: 1 / span 4;
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 600px;
      z-index: 35;
    }
    #urgent-banner { grid-column: 2; grid-row: 1; }
    #app-shell > header { grid-column: 2; grid-row: 2; }
    #app-shell > nav[aria-label="Seções principais"] { display: none; }
    #reminders-view, #workshops-view, #professor-view {
      grid-column: 2;
      grid-row: 3;
      width: auto;
      max-width: none;
      margin: 0;
    }
    #app-shell > footer { grid-column: 2; grid-row: 4; margin-top: 0; }
    #app-shell > header.app-topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      background: #fff;
      color: #0f172a;
      border-bottom: 1px solid #e2e8f0;
      box-shadow: none;
    }
    .sidebar-link[aria-current="page"] { background: #ecfdf5; color: #047857; font-weight: 700; }
    .sidebar-link:hover { background: #f0fdf4; color: #047857; }
    .mobile-settings-link { display: none; }
    .sidebar-label-mobile { display: none; }
    #workshop-main-tabs .workshop-quick-register { flex: 1 0 100%; margin-left: 0; }
    #workshops-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .85rem; }
    #workshops-list > * { margin-top: 0 !important; min-width: 0; }
    @media (max-width: 900px) {
      #app-shell.app-layout:not(.hidden) { display: flex !important; flex-direction: column; min-height: 100vh; }
      #app-sidebar { position: fixed; top: auto; bottom: 0; left: 0; right: 0; width: 100%; height: 62px; min-height: 0; z-index: 60; border-right: 0; border-top: 1px solid #e2e8f0; padding-bottom: env(safe-area-inset-bottom); }
      #app-sidebar .sidebar-brand, #app-sidebar .sidebar-section-label, #app-sidebar .sidebar-bottom, #app-sidebar .sidebar-desktop-settings { display: none; }
      #app-sidebar .sidebar-nav { display: flex; flex-direction: row; width: 100%; height: 100%; overflow: visible; gap: .1rem; padding: .25rem .35rem; align-items: stretch; justify-content: space-around; }
      #app-sidebar .sidebar-link { min-width: 0; flex: 1 1 0; display: flex; flex-direction: column; justify-content: center; gap: .15rem; white-space: nowrap; border-radius: .75rem; padding: .25rem .1rem; font-size: .62rem; line-height: 1; }
      #app-sidebar .sidebar-link svg { width: 18px; height: 18px; }
      #app-sidebar .sidebar-label-desktop { display: none; }
      #app-sidebar .sidebar-label-mobile { display: inline; }
      #app-sidebar .mobile-settings-link { display: flex; }
      #app-shell > header.app-topbar { position: sticky; top: 0; }
      #reminders-view, #workshops-view, #professor-view { width: 100%; padding-bottom: 88px; }
      #app-shell > footer { display: none; }
      #settings-modal, #booking-modal, #confirm-modal { z-index: 80; }
      #toast-container { bottom: calc(70px + env(safe-area-inset-bottom)); left: .75rem; right: .75rem; width: auto; max-width: none; }
    }
    @media (max-width: 640px) {
      html, body { width: 100%; max-width: 100%; overflow-x: clip; }
      #app-shell { width: 100%; max-width: 100vw; overflow-x: clip; }
      .login-layout { display: flex; flex-direction: column; }
      .login-intro { min-height: 150px; padding: 1.25rem; }
      .login-intro-copy { display: none; }
      .login-card-zone { flex: 1; min-height: auto; padding: 1rem; }
      #app-shell > header.app-topbar > div { padding: .5rem .65rem; }
      #app-shell > header.app-topbar > div > div { min-width: 0; flex-wrap: wrap; gap: .35rem .5rem; }
      #app-shell > header.app-topbar .topbar-brand { min-width: 0; width: 100%; flex: 1 1 100%; gap: .5rem; }
      #app-shell > header.app-topbar .topbar-brand > div { min-width: 0; flex: 1 1 auto; }
      #app-shell > header.app-topbar .topbar-mobile-mark { display: block; }
      #app-shell > header.app-topbar .topbar-brand h1 { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; white-space: normal; overflow-wrap: anywhere; font-size: .9rem; line-height: 1.15; }
      #app-shell > header.app-topbar .topbar-brand p { margin-top: .18rem; font-size: .64rem; line-height: 1.25; }
      #app-shell > header.app-topbar .topbar-actions { display: grid; width: 100%; min-width: 0; flex: 1 1 100%; grid-template-columns: 2.5rem 2.5rem minmax(0, 1fr); gap: .35rem; }
      #app-shell > header.app-topbar #btn-sound-toggle, #app-shell > header.app-topbar #btn-notif-perm { width: 2.5rem; min-width: 2.5rem; min-height: 2.4rem; justify-content: center; padding: .45rem; }
      #app-shell > header.app-topbar button[onclick="openSettingsModal()"] { display: none; }
      #app-shell > header.app-topbar #new-reminder-button { width: 100%; min-width: 0; min-height: 2.4rem; justify-content: center; padding: .45rem .55rem; font-size: .72rem; gap: .3rem; white-space: nowrap; }
      #app-shell > header.app-topbar #new-reminder-button i { width: .9rem; height: .9rem; }
      #app-shell > header.app-topbar #label-sound, #app-shell > header.app-topbar #label-notif { display: none; }
      #reminders-view, #workshops-view, #professor-view { min-width: 0; padding: .85rem .7rem calc(82px + env(safe-area-inset-bottom)); }
      #reminders-view > *, #workshops-view > *, #professor-view > * { min-width: 0; max-width: 100%; }
      #professor-view > section:first-child > div:first-child { min-width: 0; }
      #professor-view > section:first-child > div:first-child > div:last-of-type { min-width: 0; flex: 1 1 180px; }
      #professor-now-button { width: 100%; justify-content: center; }
      #app-sidebar { height: calc(62px + env(safe-area-inset-bottom)); }
      #app-sidebar .sidebar-nav { padding-bottom: calc(.25rem + env(safe-area-inset-bottom)); }
      #app-sidebar .sidebar-link { overflow: hidden; }
      #app-sidebar .sidebar-link span { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
      #workshop-progress-panel > section { align-items: stretch; }
      #workshop-progress-panel > section > div:last-child { width: 100%; min-width: 0; }
      #workshop-progress-panel > section > div:last-child > div { min-width: 0; width: 100%; }
      #workshop-main-tabs .workshop-quick-register { flex-basis: 100%; margin-left: 0; }
      #workshop-main-tabs [role="tab"] { display: flex; min-width: 0; flex: 1 1 auto; align-items: center; justify-content: center; padding: .5rem .45rem; font-size: .68rem; line-height: 1.2; }
      #workshop-main-tabs [role="tab"] i { flex: 0 0 auto; }
      #settings-modal { padding: 0; }
      #settings-modal > div { width: 100%; max-width: none; height: 100dvh; max-height: 100dvh; border-radius: 0; }
      #settings-modal input, #settings-modal select, #settings-modal button { min-width: 0; max-width: 100%; }
      #workshops-list { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

  <section id="login-screen" class="fixed inset-0 z-[100] overflow-y-auto bg-slate-50">
    <div class="login-layout grid w-full lg:grid-cols-2">
      <aside class="login-intro hidden flex-col justify-between p-8 text-white lg:flex xl:p-10">
        <div class="flex items-center gap-3">
          <img src="icons/icon-192.png" alt="" class="h-14 w-14 shrink-0 object-contain" />
          <div><h1 class="font-extrabold tracking-tight">LembretesEduTec</h1><p class="text-xs text-emerald-50">Tecnologia Educacional & Robótica</p></div>
        </div>
        <div class="login-intro-copy max-w-xl py-12">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold"><span class="h-2 w-2 rounded-full bg-emerald-200"></span> Plataforma integrada de laboratório e robótica</span>
          <h2 class="mt-6 text-4xl font-extrabold leading-tight xl:text-5xl">Organize equipamentos, horários e oficinas em um só lugar.</h2>
          <p class="mt-4 max-w-lg text-base leading-relaxed text-emerald-50">Controle entregas e devoluções com alertas, localize professores em tempo real e acompanhe as oficinas de robótica.</p>
          <div class="mt-7 flex flex-wrap gap-3"><span class="rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold">Gestão de Acervo</span><span class="rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm font-semibold">Oficinas de Robótica</span></div>
        </div>
        <div class="flex justify-between border-t border-white/20 pt-4 text-xs text-emerald-50"><span>LembretesEduTec</span><span>Sincronização local e nuvem</span></div>
      </aside>
      <div class="login-card-zone flex min-h-screen items-center justify-center px-4 py-8 sm:px-8">
      <div class="w-full max-w-md rounded-3xl border border-slate-200 bg-white p-6 shadow-xl sm:p-8">
      <div class="mb-6">
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Bem-vindo(a)</h2>
        <p id="login-subtitle" class="mt-1 text-sm text-slate-500">Acesse sua conta para continuar</p>
      </div>
      <form id="login-form" onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label for="login-email" class="mb-1 block text-sm font-semibold text-slate-700">E-mail</label>
          <input id="login-email" name="email" type="email" autocomplete="username" autocapitalize="none" required
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-3 text-base focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>
        <div>
          <label for="login-password" class="mb-1 block text-sm font-semibold text-slate-700">Senha</label>
          <input id="login-password" name="password" type="password" autocomplete="current-password" required
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-3 text-base focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>
        <p id="login-status" class="min-h-5 text-xs text-slate-500" aria-live="polite">Conectando ao serviço de autenticação…</p>
        <button id="login-submit" type="submit" class="w-full rounded-xl bg-emerald-600 px-4 py-3 font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50">
          Entrar
        </button>
        <button type="button" onclick="showForgotPassword()" class="w-full text-sm font-semibold text-emerald-600 hover:text-emerald-800">
          Esqueci minha senha
        </button>
      </form>
      <form id="forgot-password-form" onsubmit="handleForgotPassword(event)" class="hidden space-y-4">
        <p class="text-sm leading-relaxed text-slate-600">Informe o e-mail cadastrado na sua conta. Enviaremos um link para você criar uma nova senha.</p>
        <div>
          <label for="recovery-email" class="mb-1 block text-sm font-semibold text-slate-700">E-mail da conta</label>
          <input id="recovery-email" name="email" type="email" autocomplete="email" required
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-3 text-base focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>
        <p id="forgot-password-status" class="min-h-5 text-xs text-slate-500" aria-live="polite"></p>
        <button id="forgot-password-submit" type="submit" class="w-full rounded-xl bg-emerald-600 px-4 py-3 font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:opacity-50">
          Enviar link de recuperação
        </button>
        <button type="button" onclick="showStandardLogin()" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
          Voltar ao login
        </button>
      </form>
      <div id="local-admin-access" class="mt-5 border-t border-slate-200 pt-4">
        <button type="button" onclick="enterLocalAdminMode()" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-100">
          Acesso administrativo local
        </button>
        <p class="mt-2 text-center text-[11px] leading-relaxed text-slate-500">Usa os dados deste aparelho. As alterações não serão sincronizadas com o Firebase.</p>
      </div>
      </div>
    </div>
  </section>

  <div id="app-shell" class="hidden app-layout min-h-screen">
  <aside id="app-sidebar" class="flex flex-col border-r border-slate-200 bg-white">
    <div class="sidebar-brand flex h-[68px] items-center gap-3 border-b border-slate-100 px-5">
      <img src="icons/icon-192.png" alt="" class="h-9 w-9 shrink-0 rounded-xl object-contain" />
      <div><p class="font-extrabold tracking-tight text-slate-900">LembretesEduTec</p><p class="text-[11px] text-slate-500">Painel Escolar</p></div>
    </div>
    <p class="sidebar-section-label px-4 pb-2 pt-6 text-[10px] font-bold uppercase tracking-widest text-slate-400">Módulos</p>
    <nav class="sidebar-nav flex flex-col gap-1 px-2" aria-label="Módulos do app">
      <button id="sidebar-tab-reminders" type="button" onclick="switchAppTab('reminders')" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-slate-700" aria-current="page"><i data-lucide="laptop" class="h-4 w-4"></i><span>Equipamentos</span></button>
      <button id="sidebar-tab-workshops" type="button" onclick="switchAppTab('workshops')" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-slate-700"><i data-lucide="bot" class="h-4 w-4"></i><span class="sidebar-label-desktop">Oficinas de Robótica</span><span class="sidebar-label-mobile">Robótica</span></button>
      <button id="sidebar-tab-professor" type="button" onclick="switchAppTab('professor')" class="sidebar-link flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-slate-700"><i data-lucide="map-pin" class="h-4 w-4"></i><span class="sidebar-label-desktop">Localizar Professor</span><span class="sidebar-label-mobile">Professores</span></button>
      <button id="sidebar-tab-settings-mobile" type="button" onclick="openSettingsModal()" class="sidebar-link mobile-settings-link items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-slate-700"><i data-lucide="settings" class="h-4 w-4"></i><span>Ajustes</span></button>
    </nav>
    <p class="sidebar-section-label px-4 pb-2 pt-6 text-[10px] font-bold uppercase tracking-widest text-slate-400">Sistema</p>
    <div class="sidebar-desktop-settings px-2"><button id="sidebar-settings-desktop" type="button" onclick="openSettingsModal()" class="sidebar-link flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-slate-700"><i data-lucide="settings" class="h-4 w-4"></i><span>Configurações</span></button></div>
    <div class="sidebar-bottom mt-auto border-t border-slate-100 p-3">
      <div class="mb-2 rounded-xl border border-slate-200 bg-slate-50 p-3"><div class="flex items-center justify-between text-xs"><span class="font-semibold text-slate-700">Monitoramento Ativo</span><span id="sidebar-clock" class="font-mono text-emerald-700"></span></div><p class="mt-2 text-[11px] leading-relaxed text-slate-500">Alertas de equipamentos e oficinas ligados.</p></div>
      <button type="button" onclick="signOut()" class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-100"><i data-lucide="log-out" class="h-4 w-4"></i>Sair da Sessão</button>
    </div>
  </aside>

  <!-- Barra de Notificação Flutuante (Toast / Alertas Internos) -->
  <div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- Banner de Alerta Urgente no Topo (exibido quando há atraso ou lembrete próximo) -->
  <div id="urgent-banner" class="hidden bg-rose-600 text-white px-4 py-2.5 shadow-md transition-all">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2 text-sm">
      <div class="flex items-center gap-2 font-medium">
        <i data-lucide="bell-ring" class="w-5 h-5 animate-bounce shrink-0"></i>
        <span id="urgent-banner-text">Você tem compromissos próximos ou atrasados!</span>
      </div>
      <button onclick="dismissUrgentBanner()" class="text-xs bg-rose-700 hover:bg-rose-800 px-3 py-1 rounded-lg font-semibold transition">
        Dispensar aviso
      </button>
    </div>
  </div>

  <!-- Cabeçalho Principal -->
  <header class="app-topbar bg-white text-slate-900 sticky top-0 z-30">
    <div class="max-w-none mx-auto px-5 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <!-- Logo e Título -->
        <div class="topbar-brand flex items-center gap-3">
          <img src="icons/icon-192.png" alt="" class="topbar-mobile-mark hidden h-10 w-10 shrink-0 object-contain" />
          <div>
            <h1 id="app-page-title" class="text-lg sm:text-xl font-bold tracking-tight leading-tight">Agendamento de Equipamentos</h1>
            <p class="text-xs text-slate-500 flex items-center gap-1.5 mt-0.5">
              <i data-lucide="calendar-days" class="w-3.5 h-3.5"></i>
              <span id="live-clock">Carregando relógio...</span>
            </p>
          </div>
        </div>

        <!-- Controles Rápidos (Som, Notificações, Configurações, Novo) -->
        <div class="topbar-actions flex items-center gap-2 sm:gap-2.5">
          <!-- Toggle Alerta Sonoro -->
          <button id="btn-sound-toggle" onclick="toggleSound()" title="Ativar/Desativar Alerta Sonoro"
            class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium bg-white hover:bg-slate-50 transition border border-slate-200 text-slate-600">
            <i id="icon-sound" data-lucide="volume-2" class="w-4 h-4 text-emerald-600"></i>
            <span class="hidden md:inline" id="label-sound">Som Ativo</span>
          </button>

          <!-- Botão Notificações do Navegador -->
          <button id="btn-notif-perm" onclick="requestNotificationPermission()" title="Ativar Notificações do Navegador"
            class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium bg-white hover:bg-slate-50 transition border border-slate-200 text-slate-600">
            <i id="icon-notif" data-lucide="bell" class="w-4 h-4 text-amber-500"></i>
            <span class="hidden md:inline" id="label-notif">Notificações</span>
          </button>

          <!-- Menu de Dados / Configurações -->
          <button onclick="openSettingsModal()" title="Configurações e Backup"
            class="p-2 rounded-xl bg-white hover:bg-slate-50 transition border border-slate-200 text-slate-600">
            <i data-lucide="settings" class="w-4 h-4"></i>
          </button>

          <!-- Botão Principal: Lembrete -->
          <button id="new-reminder-button" onclick="openCurrentReminderForm()"
            class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-semibold px-4 py-2 rounded-xl shadow-sm transition text-sm">
            <i data-lucide="plus-circle" class="w-4 h-4"></i>
            <span id="new-reminder-label">Novo Agendamento</span>
          </button>
        </div>
      </div>
    </div>
  </header>

