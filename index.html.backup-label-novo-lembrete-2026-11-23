                <i data-lucide="pencil" class="w-4 h-4"></i>
              </button>
              <button onclick="confirmDeleteBooking('${b.id}')" title="Excluir agendamento"
                class="p-2.5 rounded-xl text-slate-500 hover:text-rose-600 hover:bg-rose-50 border border-slate-200 transition">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        </article>
