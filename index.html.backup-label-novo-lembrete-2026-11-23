    function checkRemindersAndUrgencies(now) {
      const leadMs = settings.leadTimeMinutes * 60 * 1000;
      let urgentMessages = [];
      let triggerSound = false;

      bookings.forEach((b) => {
        if (b.status === 'completed') return;

        const targetTime = b.status === 'pending'
          ? parseDateTime(b.date, b.deliveryTime)
          : parseDateTime(b.date, b.pickupTime);

        const diffMs = targetTime.getTime() - now.getTime();
        const actionLabel = b.status === 'pending' ? 'Entrega' : 'Recolhimento';
        const timeStr = b.status === 'pending' ? b.deliveryTime : b.pickupTime;

        // 1. Atrasado (passou do horário)
        if (diffMs < 0) {
          urgentMessages.push(`${actionLabel} ATRASADA: ${b.teacher} (${b.className}) às ${timeStr}`);
          const eventKey = `${b.id}_${b.status}_overdue`;
          if (!settings.notifiedEvents[eventKey]) {
            settings.notifiedEvents[eventKey] = true;
            triggerSound = true;
            saveState();
            showToast(`Atraso: ${actionLabel} para ${b.teacher} (${b.className})!`, 'error');
            sendBrowserNotification(
              `⚠️ ${actionLabel} Atrasada!`,
              `${b.teacher} • Turma ${b.className} (previsto ${timeStr})`
            );
          }
        }
        // 2. Próximo (dentro da janela de antecedência configurada)
        else if (diffMs <= leadMs) {
          const minsLeft = Math.ceil(diffMs / 60000);
          urgentMessages.push(`${actionLabel} em ${minsLeft} min: ${b.teacher} (${b.className}) às ${timeStr}`);
          const eventKey = `${b.id}_${b.status}_upcoming`;
          if (!settings.notifiedEvents[eventKey]) {
            settings.notifiedEvents[eventKey] = true;
            triggerSound = true;
            saveState();
            showToast(`Lembrete (${minsLeft} min): ${actionLabel} — ${b.teacher} (${b.className})`, 'warning');
            sendBrowserNotification(
              `⏰ Lembrete de ${actionLabel} (${minsLeft} min)`,
              `${b.teacher} • Turma ${b.className} às ${timeStr}`
            );
          }
        }
      });

      (settings.workshops || []).forEach((workshop) => {
        if (workshop.status === 'completed') return;
        const targetTime = parseDateTime(workshop.date, workshop.startTime);
        const diffMs = targetTime.getTime() - now.getTime();
        const label = `Oficina de Robótica — ${workshop.grade}º Ano`;
        if (diffMs < 0) {
          urgentMessages.push(`${label} atrasada: ${workshop.teacher} às ${workshop.startTime}`);
          const eventKey = `${workshop.id}_workshop_overdue`;
          if (!settings.notifiedEvents[eventKey]) {
            settings.notifiedEvents[eventKey] = true;
            triggerSound = true;
            saveState();
            showToast(`A oficina do ${workshop.grade}º Ano já deveria ter começado.`, 'error');
            sendBrowserNotification('⚠️ Oficina atrasada', `${workshop.teacher} • ${workshop.grade}º Ano às ${workshop.startTime}`);
          }
        } else if (diffMs <= leadMs) {
          const minsLeft = Math.ceil(diffMs / 60000);
          urgentMessages.push(`${label} em ${minsLeft} min: ${workshop.teacher} às ${workshop.startTime}`);
          const eventKey = `${workshop.id}_workshop_upcoming`;
          if (!settings.notifiedEvents[eventKey]) {
            settings.notifiedEvents[eventKey] = true;
            triggerSound = true;
            saveState();
            showToast(`Oficina de Robótica do ${workshop.grade}º Ano em ${minsLeft} min.`, 'warning');
            sendBrowserNotification(`⏰ Oficina em ${minsLeft} min`, `${workshop.teacher} • ${workshop.grade}º Ano · ${workshop.startTime}–${workshop.endTime}`);
          }
        }
      });

      if (triggerSound) {
        playAlertChime();
      }

      const banner = document.getElementById('urgent-banner');
      const bannerText = document.getElementById('urgent-banner-text');
      if (urgentMessages.length > 0 && Date.now() > bannerDismissedUntil) {
        bannerText.textContent = urgentMessages[0] + (urgentMessages.length > 1 ? ` (+${urgentMessages.length - 1} aviso(s))` : '');
        banner.classList.remove('hidden');
      } else {
        banner.classList.add('hidden');
      }
    }

    function dismissUrgentBanner() {
      // Silencia o banner superior por 5 minutos
      bannerDismissedUntil = Date.now() + 5 * 60 * 1000;
      document.getElementById('urgent-banner').classList.add('hidden');
    }

    // =========================================================================
    // RENDERIZAÇÃO DO PAINEL, KPIs, PRÓXIMO COMPROMISSO E LISTA
    // =========================================================================
    function renderAll() {
      const now = new Date();
      const todayISO = getTodayISO();

      // 1. Atualizar KPIs (referentes a Hoje)
      const todayBookings = bookings.filter(b => b.date === todayISO);
      document.getElementById('stat-total').textContent = todayBookings.length;
      document.getElementById('stat-pending').textContent = todayBookings.filter(b => b.status === 'pending').length;
      document.getElementById('stat-inuse').textContent = todayBookings.filter(b => b.status === 'in_use').length;
      document.getElementById('stat-done').textContent = todayBookings.filter(b => b.status === 'completed').length;

      // 2. Destaque: Próximo Compromisso Imediato (qualquer data ativa, priorizando atrasados/hoje)
      renderNextActionCard(now);

      // 3. Filtrar lista principal
      if (!document.getElementById('professor-view').classList.contains('hidden')) renderProfessorLocator();
      renderWorkshops();
      const tomorrowISO = getTomorrowISO();
      let filtered = bookings.filter((b) => {
        if (currentDateFilter === 'today' && b.date !== todayISO) return false;
        if (currentDateFilter === 'tomorrow' && b.date !== tomorrowISO) return false;
        if (currentDateFilter === 'specific' && b.date !== selectedBookingCalendarDate) return false;
        if (currentStatusFilter !== 'all' && b.status !== currentStatusFilter) return false;

        if (currentSearchQuery.trim() !== '') {
          const q = currentSearchQuery.toLowerCase();
          const equipStr = b.equipments.map(e => e.name).join(' ').toLowerCase();
          const match =
            b.teacher.toLowerCase().includes(q) ||
            b.className.toLowerCase().includes(q) ||
            equipStr.includes(q) ||
            (b.notes && b.notes.toLowerCase().includes(q));
          if (!match) return false;
        }
        return true;
      });

      // Ordenação inteligente:
      // Ativos (pending / in_use) ordenados pelo próximo horário relevante; Concluídos vão para o final
      filtered.sort((a, b) => {
        if (a.status === 'completed' && b.status !== 'completed') return 1;
        if (a.status !== 'completed' && b.status === 'completed') return -1;

        const timeA = a.status === 'pending' ? `${a.date}T${a.deliveryTime}` : `${a.date}T${a.pickupTime}`;
        const timeB = b.status === 'pending' ? `${b.date}T${b.deliveryTime}` : `${b.date}T${b.pickupTime}`;
        return timeA.localeCompare(timeB);
      });

      // Título da seção
      const headingMap = {
        today: 'Linha do Tempo de Hoje',
        tomorrow: 'Agendamentos de Amanhã',
        all: 'Todos os Agendamentos'
      };
      document.getElementById('timeline-heading').textContent = currentDateFilter === 'specific'
        ? `Agendamentos de ${formatDateBR(selectedBookingCalendarDate)}`
        : headingMap[currentDateFilter];
      document.getElementById('visible-count').textContent = filtered.length;

      const listEl = document.getElementById('bookings-list');
      const emptyEl = document.getElementById('empty-state');

      if (filtered.length === 0) {
        listEl.innerHTML = '';
        emptyEl.classList.remove('hidden');
      } else {
        emptyEl.classList.add('hidden');
        listEl.innerHTML = filtered.map(b => createBookingCardHTML(b, now)).join('');
      }

      lucide.createIcons();
      const bookingCalendarPanel = document.getElementById('booking-calendar-panel');
      if (bookingCalendarPanel && !bookingCalendarPanel.classList.contains('hidden')) renderBookingCalendar();
      const bookingDayDialog = document.getElementById('booking-day-dialog');
      if (bookingDayDialog?.open) renderBookingCalendarDayDetails();
    }

    const ROBOTICS_WORKSHOP_SLOTS = {
      '1': { startTime: '13:00', endTime: '14:40', label: '1º + 2º horários' },
      '2': { startTime: '13:50', endTime: '15:30', label: '2º + 3º horários' },
      '3': { startTime: '14:40', endTime: '16:40', label: '3º + 4º horários (com intervalo)' },
      '4': { startTime: '15:50', endTime: '17:30', label: '4º + 5º horários' }
    };
    const ROBOTICS_GRADE_TEACHERS = { 1: 'Domenica', 2: 'Pamela', 3: 'Katia', 4: 'Ana Flavia', 5: 'Lisandra' };

    function normalizeRoboticsWorkshopTeachers() {
      if (!settings || !Array.isArray(settings.workshops)) return;
      settings.workshops.forEach(workshop => {
        const assignedTeacher = ROBOTICS_GRADE_TEACHERS[Number(workshop.grade)];
        if (assignedTeacher) workshop.teacher = assignedTeacher;
