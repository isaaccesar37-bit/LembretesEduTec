    function renderProfessorDirectoryCard(name, day, time, currentEntries, isSelected) {
      const scheduleEntries = currentEntries.filter(entry => entry.teacher === name);
      const today = getTodayISO();
      const todayBookings = bookings.filter(item => sameProfessorName(item.teacher, name) && item.date === today && item.status !== 'completed');
      const activeBooking = todayBookings.find(item => item.status === 'in_use');
      const pendingBooking = todayBookings.find(item => item.status === 'pending');
      const todayWorkshop = (settings.workshops || []).find(item => sameProfessorName(item.teacher, name) && item.date === today && item.status !== 'completed');
      const isScheduledNow = scheduleEntries.length && professorLocatorFollowsCurrent && day === new Date().getDay() && !professorScheduleIsWeekend;
      const status = activeBooking || isScheduledNow ? 'Em Atividade' : pendingBooking || todayWorkshop ? 'Agendado Hoje' : 'Sala dos Professores / Livre';
      const statusClass = status === 'Em Atividade' ? 'bg-emerald-100 text-emerald-800' : status === 'Agendado Hoje' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700';
      const location = activeBooking?.className || pendingBooking?.className || todayWorkshop?.className || scheduleEntries.map(entry => entry.className).join(' · ') || 'Localização padrão / Sala dos Professores';
      const equipmentText = item => (item.equipments || []).map(equipment => `${Number(equipment.qty) || 1}x ${equipment.name}`).join(', ');
