            <!-- Coluna 2: Botões de Ação Rápida -->
            <div class="flex flex-wrap sm:flex-nowrap items-center justify-end gap-2 pt-3 lg:pt-0 border-t lg:border-t-0 border-slate-100 shrink-0">
              ${isPending ? `
                <button onclick="advanceStatus('${b.id}', 'in_use')"
